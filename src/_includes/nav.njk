{% set t = translations[lang] %}
<nav class="nav">
  <div class="container nav-inner">
    <a class="nav-logo" href="/{{ lang }}/">
      <img class="nav-logo-img" src="/assets/images/ucs-logo.png" alt="Unified Cloud Sensors">
    </a>
    <div class="nav-links">
      <a href="/{{ lang }}/">{{ t.nav.home }}</a>
      <a href="/{{ lang }}/solutions/">{{ t.nav.solutions }}</a>
      <a href="/{{ lang }}/sensweight/">SensWEIGHT™</a>
      <a href="/{{ lang }}/ucsx3/">UCS X3</a>
      <a href="/{{ lang }}/events/">{{ t.nav.events }}</a>
      <a href="/{{ lang }}/demo/">{{ t.nav.demo }}</a>
    </div>
    <div class="nav-lang">
      <button class="lang-btn" data-lang="en" onclick="switchLang('en')">EN</button>
      <button class="lang-btn" data-lang="cs" onclick="switchLang('cs')">CZ</button>
      <button class="lang-btn" data-lang="pl" onclick="switchLang('pl')">PL</button>
    </div>
  </div>
</nav>
