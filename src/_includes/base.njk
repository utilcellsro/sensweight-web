<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description | default('Unified Cloud Sensors — Industrial IoT monitoring systems for remote weighing, silo level, geotechnical and environmental sensing.') }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/main.css">
  {% if pageKey == 'demo' %}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  {% endif %}
</head>
<body{% if demoKey %} data-demo-key="{{ demoKey }}"{% endif %}>
{% include "nav.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
<script>
  function switchLang(l) {
    var p = window.location.pathname.replace(/^\/(en|cs|pl)(\/|$)/, '/' + l + '/');
    window.location.href = p;
  }
  document.addEventListener('DOMContentLoaded', function () {
    var seg = window.location.pathname.split('/')[1];
    document.querySelectorAll('.lang-btn').forEach(function(b) {
      if (b.dataset.lang === seg) b.classList.add('active');
    });
    document.querySelectorAll('.nav-links a').forEach(function(a) {
      if (a.href === window.location.href) a.classList.add('active');
    });
  });
</script>
{% if pageKey == 'demo' %}
<script src="/assets/js/demo-configs.js"></script>
<script src="/assets/js/demo.js"></script>
{% endif %}
</body>
</html>
