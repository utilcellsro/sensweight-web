{% set t = translations[lang] %}
{% set h = t.how_to_buy %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ h.tagline }}</div>
    <h1>{{ h.heading }}</h1>
    <p class="page-hero-sub">{{ h.sub }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-num">{{ h.step1_num }}</div>
        <h3>{{ h.step1_title }}</h3>
        <p>{{ h.step1_body }}</p>
      </div>
      <div class="step-card">
        <div class="step-num">{{ h.step2_num }}</div>
        <h3>{{ h.step2_title }}</h3>
        <p>{{ h.step2_body }}</p>
      </div>
      <div class="step-card">
        <div class="step-num">{{ h.step3_num }}</div>
        <h3>{{ h.step3_title }}</h3>
        <p>{{ h.step3_body }}</p>
      </div>
    </div>
  </div>
</section>

<section class="product-cta">
  <div class="container">
    <h2>{{ h.cta_heading }}</h2>
    <p>{{ h.cta_sub }}</p>
    <div class="product-cta-btns">
      <a href="/{{ lang }}/request-a-dealer/" class="btn btn-teal">{{ h.cta_dealer }}</a>
      <a href="/{{ lang }}/demo/" class="btn btn-ghost">{{ h.cta_demo }}</a>
    </div>
  </div>
</section>
