{% set t = translations[lang] %}
{% set d = t.demos[demoKey] %}
{% set p = t.products[demoKey] %}

{# ── DEMO HEADER ─────────────────────────────────────────────── #}
<div class="demo-header">
  <div class="container">
    <div class="demo-system-name">{{ d.system }}</div>
    <h1>{{ d.title }}</h1>
    <div class="demo-status">
      <div class="live-dot"></div>
      <span>{{ d.subtitle }}</span>
      &mdash;
      <span class="update-time" id="update-time">--:--:--</span>
    </div>
  </div>
</div>

{# ── SUMMARY BAR ─────────────────────────────────────────────── #}
<div class="summary-bar">
  <div class="container">
    <div class="summary-inner">
      <div class="summary-item">
        <div class="summary-label">{{ d.label_total }}</div>
        <div class="summary-value" id="total-load">&mdash;</div>
        <div class="summary-sub">{{ d.sub_combined }}</div>
      </div>
      <div class="summary-item">
        <div class="summary-label">{{ d.label_avg }}</div>
        <div class="summary-value" id="avg-load">&mdash;</div>
        <div class="summary-sub">{{ d.sub_per }}</div>
      </div>
      <div class="summary-item">
        <div class="summary-label">{{ d.label_dev }}</div>
        <div class="summary-value" id="max-dev">&mdash;</div>
        <div class="summary-sub">{{ d.sub_balance }}</div>
      </div>
      <div class="summary-item">
        <div class="summary-label">{{ d.label_status }}</div>
        <div class="summary-value status-ok">{{ d.status_ok }}</div>
        <div class="summary-sub">{{ d.count }} / {{ d.count }} {{ d.sub_sensors }}</div>
      </div>
    </div>
  </div>
</div>

{# ── MAIN PANELS ─────────────────────────────────────────────── #}
<div class="demo-body">
  <div class="container">
    <div class="demo-grid">

      <div class="demo-panel">
        <div class="panel-header">
          <span class="panel-title">{{ d.chart_title }}</span>
          <span class="panel-badge">LIVE</span>
        </div>
        <div class="chart-container">
          <canvas id="radar-chart"></canvas>
        </div>
      </div>

      <div class="demo-panel">
        <div class="panel-header">
          <span class="panel-title">{{ d.table_title }}</span>
          <span class="panel-badge">LIVE</span>
        </div>
        <table class="sensor-table">
          <thead>
            <tr>
              <th>{{ d.col_sensor }}</th>
              <th>{{ d.col_current }}</th>
              <th>{{ d.col_min }}</th>
              <th>{{ d.col_max }}</th>
              <th>{{ d.col_status }}</th>
            </tr>
          </thead>
          <tbody id="sensor-tbody">
            <tr>
              <td colspan="5" style="text-align:center;color:#718096;padding:20px;font-family:var(--font)">
                Loading sensor data&hellip;
              </td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>

{# ── CTA ──────────────────────────────────────────────────────── #}
<section class="product-cta">
  <div class="container">
    <h2>{{ p.name }}</h2>
    <p>{{ p.desc }}</p>
    <div class="product-cta-btns">
      <a href="/{{ lang }}/{{ demoKey }}/" class="btn btn-teal">{{ t.demo_hub.cta_learn }}</a>
      <a href="/{{ lang }}/demo/" class="btn btn-ghost">{{ t.demo_hub.cta_all }}</a>
    </div>
  </div>
</section>
