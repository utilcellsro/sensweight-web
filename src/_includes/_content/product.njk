{% set t = translations[lang] %}
{% set p = t[productKey] %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ p.hero_tagline }}</div>
    <h1>{{ p.hero_headline }}</h1>
    <p class="page-hero-sub">{{ p.hero_sub }}</p>
    <div class="page-hero-badges">
      {% for b in p.badges %}
      <span class="hero-badge">{{ b }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.features_title }}</div>
      <h2>Everything you need. Nothing you don't.</h2>
    </div>
    <div class="features-grid">
      {% for f in p.features %}
      <div class="feature-card">
        <div class="feature-icon">{{ "0" if loop.index < 10 }}{{ loop.index }}</div>
        <h3>{{ f.title }}</h3>
        <p>{{ f.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.specs_title }}</div>
      <h2>Technical Specifications</h2>
    </div>
    <div class="specs-wrap">
      <table class="specs-table">
        <thead><tr><th>Parameter</th><th>Value</th></tr></thead>
        <tbody>
          {% for s in p.specs %}
          <tr><td>{{ s.label }}</td><td>{{ s.value }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.usecases_title }}</div>
      <h2>Built for how industry actually works</h2>
    </div>
    <div class="usecase-grid">
      {% for u in p.usecases %}
      <div class="usecase-card">
        <h3>{{ u.title }}</h3>
        <p>{{ u.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">In Action</div>
      <h2>See it working</h2>
    </div>
    <div class="vid-embed-wrap">
      <div class="vid-placeholder">
        <span>{{ t.video.placeholder }}</span>
      </div>
    </div>
  </div>
</section>

<section class="product-cta">
  <div class="container">
    <h2>Ready to see it live?</h2>
    <p>Talk to our team about deploying this solution in your facility.</p>
    <div class="product-cta-btns">
      <a href="/{{ lang }}/demo/{{ productKey }}/" class="btn btn-teal">{{ p.cta_demo }}</a>
      <a href="#" class="btn btn-ghost">{{ p.cta_contact }}</a>
    </div>
  </div>
</section>
