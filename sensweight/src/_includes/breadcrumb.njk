{% set t = translations[lang] %}
{% if pageKey and pageKey != 'home' %}
{% set home = '/' | localeUrl(lang) %}
<div class="breadcrumb">
  <div class="container breadcrumb-inner">

    {% if pageKey == 'industries' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.nav.industries }}</span>

    {% elif pageKey == 'industry' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><a href="{{ '/industries/' | localeUrl(lang) }}">{{ t.nav.industries }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.industries.items[industryKey].name }}</span>

    {% elif pageKey == 'solutions' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.nav.solutions }}</span>

    {% elif pageKey in ['sensweight', 'senssilo'] %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><a href="{{ '/solutions/' | localeUrl(lang) }}">{{ t.nav.solutions }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.products[pageKey].name }}</span>

    {% elif pageKey == 'products' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.nav.products }}</span>

    {% elif pageKey == 'ucsx3' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><a href="{{ '/products/' | localeUrl(lang) }}">{{ t.nav.products }}</a><span class="crumb-sep">/</span><span class="crumb-current">UCS X3</span>

    {% elif pageKey == 'how-to-buy' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.ui.how_to_buy }}</span>

    {% elif pageKey == 'demo-hub' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.nav.demo }}</span>

    {% elif pageKey == 'demo' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><a href="{{ '/demo/' | localeUrl(lang) }}">{{ t.nav.demo }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.products[demoKey].name }}</span>

    {% elif pageKey == 'privacy' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.ui.privacy }}</span>

    {% elif pageKey == 'terms' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.ui.terms }}</span>

    {% elif pageKey == 'events' %}
      <a href="{{ home }}">{{ t.ui.home }}</a><span class="crumb-sep">/</span><span class="crumb-current">{{ t.nav.events }}</span>

    {% endif %}

  </div>
</div>
{% endif %}
