{% set t = translations[lang] %}

{# ── HERO ──────────────────────────────────────────────────── #}
<section class="hero hero-dark hero-video-bg-section">
  <div class="hero-video-carousel" aria-hidden="true">
    {% for v in heroVideos %}
    <div class="hero-video-slide{{ ' is-active' if loop.first }}" data-index="{{ loop.index0 }}">
      {% if v.mp4 %}
      <video class="hero-video" poster="{{ v.poster }}" muted playsinline loop preload="auto" {{ 'autoplay' if loop.first }}>
        <source src="{{ v.mp4 }}" type="video/mp4">
      </video>
      {% else %}
      <img class="hero-video" src="{{ v.poster }}" alt="{{ v.alt }}" loading="{{ 'eager' if loop.first else 'lazy' }}">
      {% endif %}
    </div>
    {% endfor %}
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-top">
      <div class="hero-content">
        <div class="hero-tagline">{{ t.hero.tagline }}</div>
        <h1>{{ t.hero.headline }}</h1>
        <p class="hero-sub">{{ t.hero.sub }}</p>
      </div>
    </div>
    <div class="hero-tiles">
      <a href="/industries/" class="hero-tile">
        <span class="hero-tile-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
        <span class="hero-tile-text">
          <span class="hero-tile-title">{{ t.hero.tile1_title }}</span>
          <span class="hero-tile-sub">{{ t.hero.tile1_sub }}</span>
        </span>
      </a>
      <a href="/solutions/" class="hero-tile">
        <span class="hero-tile-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 15l3-4 3 2 4-6"/></svg></span>
        <span class="hero-tile-text">
          <span class="hero-tile-title">{{ t.hero.tile3_title }}</span>
          <span class="hero-tile-sub">{{ t.hero.tile3_sub }}</span>
        </span>
      </a>
      <a href="/products/" class="hero-tile">
        <span class="hero-tile-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
        <span class="hero-tile-text">
          <span class="hero-tile-title">{{ t.hero.tile2_title }}</span>
          <span class="hero-tile-sub">{{ t.hero.tile2_sub }}</span>
        </span>
      </a>
    </div>
  </div>
</section>

{# ── HOW IT WORKS — FLOW DIAGRAM ──────────────────────────── #}
<section class="section flow-section">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ t.flow.tagline }}</div>
      <h2>{{ t.flow.heading }}</h2>
      <p class="section-sub">{{ t.flow.sub }}</p>
    </div>
    <div class="flow-grid">
      <div class="flow-node">
        <div class="flow-node-icon flow-node-icon--muted"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="6.5"/><path d="M14.7 14.7 20 20"/><path d="M7 10h6M10 7v6"/></svg></div>
        <h3>{{ t.flow.node1_title }}</h3>
        <p>{{ t.flow.node1_sub }}</p>
      </div>
      <div class="flow-arrow">&rarr;</div>
      <div class="flow-node">
        <div class="flow-node-icon flow-node-icon--accent"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/><path d="M10 2v3M14 2v3M10 19v3M14 19v3M2 10h3M2 14h3M19 10h3M19 14h3"/><circle cx="12" cy="12" r="2.5"/></svg></div>
        <h3>{{ t.flow.node2_title }}</h3>
        <p>{{ t.flow.node2_sub }}</p>
      </div>
      <div class="flow-arrow">&rarr;</div>
      <div class="flow-node">
        <div class="flow-node-icon flow-node-icon--navy"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1 0-8 5 5 0 0 1 9.6-1.4A3.5 3.5 0 0 1 17.5 18H7z"/><path d="M9 14l2 2 4-4"/></svg></div>
        <h3>{{ t.flow.node3_title }}</h3>
        <p>{{ t.flow.node3_sub }}</p>
      </div>
    </div>
  </div>
</section>

{# ── SOLUTIONS — same 3 photo tiles as unifiedcloudsensors.com (SensWEIGHT Bridge / SensSILO / SensBELT) ── #}
<section class="section" id="solutions">
  <div class="container">
    <div class="section-header section-header--split">
      <div class="section-header-text">
        <div class="section-tagline">{{ t.products_section_title }}</div>
        <h2>{{ t.products_subtitle }}</h2>
      </div>
      <a href="/solutions/" class="section-header-link">See all solutions &rarr;</a>
    </div>
    {% include "_content/solution-tiles.njk" %}
    </div>
  </div>
</section>

{# ── INDUSTRIES (routes out, no duplicated depth) ───────────── #}
<section class="section section-alt">
  <div class="container">
    <div class="section-header section-header--split">
      <div class="section-header-text">
        <div class="section-tagline">{{ t.industries.index_tagline }}</div>
        <h2>Find your industry</h2>
      </div>
      <a href="/industries/" class="section-header-link">All industries &rarr;</a>
    </div>
    {% include "_content/industry-tiles.njk" %}
  </div>
</section>

{# ── VIDEO ─────────────────────────────────────────────────── #}
<section class="section video-section" id="videos">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ t.video.section_title }}</div>
      <h2>{{ t.video.section_heading }}</h2>
    </div>
    <div class="video-grid">
      <div class="vid-main" data-vid="YOUR_VIDEO_ID_1">
        <div class="vid-thumb"></div>
        <div class="vid-play"><div class="vid-play-btn"></div></div>
        <div class="vid-placeholder-text">{{ t.video.placeholder }}</div>
      </div>
      <div class="vid-side">
        <div class="vid-card" data-vid="YOUR_VIDEO_ID_2">
          <div class="vid-thumb"></div>
          <div class="vid-play"><div class="vid-play-btn vid-play-btn--sm"></div></div>
          <div class="vid-placeholder-text">{{ t.video.placeholder }}</div>
        </div>
        <div class="vid-card" data-vid="YOUR_VIDEO_ID_3">
          <div class="vid-thumb"></div>
          <div class="vid-play"><div class="vid-play-btn vid-play-btn--sm"></div></div>
          <div class="vid-placeholder-text">{{ t.video.placeholder }}</div>
        </div>
      </div>
    </div>
  </div>
</section>

{# ── ROI CALCULATOR TEASER — temporarily held (Task 19), remove this wrapper to restore; full calculator lives on each Solution page
<section class="section section-alt roi-teaser">
  <div class="container roi-teaser-inner">
    <p class="roi-teaser-heading">{{ t.roi.teaser_heading }}</p>
    <div class="roi-teaser-links">
      <a href="/sensweight/#roi" class="roi-teaser-link">{{ t.products.sensweight.name }} &rarr;</a>
      <a href="/senssilo/#roi" class="roi-teaser-link">{{ t.products.senssilo.name }} &rarr;</a>
    </div>
  </div>
</section>
#}

{# ── CERTIFICATION / TRUST ─────────────────────────────────── #}
<section class="section trust-section" id="certifications">
  <div class="container trust-grid">
    <div class="trust-seal" aria-hidden="true">
      <svg width="72" height="86" viewBox="0 0 72 86" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="36" cy="34" r="26"/>
        <circle cx="36" cy="34" r="19" stroke-dasharray="3 4"/>
        <path d="M27 34l6 6 12-13"/>
        <path d="M24 56 18 80 30 72 36 82 42 72 54 80 48 56"/>
      </svg>
    </div>
    <div class="trust-content">
      <div class="section-tagline">{{ t.trust.tagline }}</div>
      <h2>{{ t.trust.heading }}</h2>
      <p class="section-sub">{{ t.trust.sub }}</p>
      <div class="patent-block">
        <span class="patent-block-label">{{ t.trust.patent.label }}</span>
        <span class="patent-block-number">{{ t.trust.patent.number }}</span>
        <p class="patent-block-detail">{{ t.trust.patent.detail }}</p>
      </div>
      <div class="trust-items">
        {% for item in t.trust.items %}
        <div class="trust-item">
          <span class="trust-item-label">{{ item.label }}</span>
          <span class="trust-item-value">{{ item.value }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{# ── HOW TO BUY (routes out, no duplicated depth) ───────────── #}
<section class="product-cta" id="how-to-buy">
  <div class="container">
    <h2>{{ t.home_cta.heading }}</h2>
    <p>{{ t.home_cta.sub }}</p>
    <div class="product-cta-btns">
      <a href="/how-to-buy/" class="btn btn-teal">{{ t.home_cta.cta_buy }}</a>
      <a href="/products/" class="btn btn-ghost">{{ t.home_cta.cta_products }}</a>
    </div>
  </div>
</section>

<script src="/assets/js/home.js"></script>
<script src="/assets/js/hero-carousel.js"></script>
