{% set t = translations[lang] %}
{% set p = t.sensweight %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ p.hero_tagline }}</div>
    <h1>{{ p.hero_headline }}</h1>
    <p class="page-hero-sub">{{ p.hero_sub }}</p>
    <div class="page-hero-badges">
      {% for b in p.badges %}
      <span class="hero-badge">{{ b }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.pitch_tagline }}</div>
      <h2>{{ p.pitch_heading }}</h2>
    </div>
    <p class="section-sub">{{ p.pitch_body }}</p>
  </div>
</section>

{% set s = p.story %}
{% include "_content/product-story.njk" %}

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.features_title }}</div>
      <h2>Everything you need. Nothing you don't.</h2>
    </div>
    <div class="features-grid">
      {% for f in p.features %}
      <div class="feature-card">
        <div class="feature-icon">{{ "0" if loop.index < 10 }}{{ loop.index }}</div>
        <h3>{{ f.title }}</h3>
        <p>{{ f.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.specs_title }}</div>
      <h2>SensWEIGHT® at a glance</h2>
    </div>
    <div class="specs-wrap">
      <table class="specs-table">
        <thead>
          <tr><th>Parameter</th><th>Value</th></tr>
        </thead>
        <tbody>
          {% for s in p.specs %}
          <tr><td>{{ s.label }}</td><td>{{ s.value }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

{# ROI calculator temporarily held — uncomment to restore: {% include "_content/roi-calculator.njk" %} #}

<section class="product-cta">
  <div class="container">
    <div class="section-tagline">Next step</div>
    <h2>{{ p.story.pilot.heading }}</h2>
    <p>{{ p.story.pilot.body }}</p>
    <div class="steps-grid pilot-points">
      {% for pt in p.story.pilot.points %}
      <div class="step-card">
        <h3>{{ pt.title }}</h3>
        <p>{{ pt.body }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="product-cta-btns">
      <a href="/how-to-buy/#dealer-form" class="btn btn-teal">Start a pilot</a>
      <a href="/demo/sensweight/" class="btn btn-ghost">{{ p.cta_demo }}</a>
    </div>
  </div>
</section>

<script src="/assets/js/home.js"></script>
