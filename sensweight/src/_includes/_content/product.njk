{% set t = translations[lang] %}
{% set p = t[productKey] %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ p.hero_tagline }}</div>
    <h1>{{ p.hero_headline }}</h1>
    <p class="page-hero-sub">{{ p.hero_sub }}</p>
    <div class="page-hero-badges">
      {% for b in p.badges %}
      <span class="hero-badge">{{ b }}</span>
      {% endfor %}
    </div>
  </div>
</section>

{% if p.pitch_body %}
<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.pitch_tagline }}</div>
      <h2>{{ p.pitch_heading }}</h2>
    </div>
    <p class="section-sub">{{ p.pitch_body }}</p>
  </div>
</section>
{% endif %}

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.features_title }}</div>
      <h2>{{ t.labels.features_sub }}</h2>
    </div>
    <div class="features-grid">
      {% for f in p.features %}
      <div class="feature-card">
        <div class="feature-icon">{{ "0" if loop.index < 10 }}{{ loop.index }}</div>
        <h3>{{ f.title }}</h3>
        <p>{{ f.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.specs_title }}</div>
      <h2>{{ t.labels.specs_title }}</h2>
    </div>
    <div class="specs-wrap">
      <table class="specs-table">
        <thead><tr><th>{{ t.labels.param }}</th><th>{{ t.labels.value }}</th></tr></thead>
        <tbody>
          {% for s in p.specs %}
          <tr><td>{{ s.label }}</td><td>{{ s.value }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ p.usecases_title }}</div>
      <h2>{{ t.labels.usecases_sub }}</h2>
    </div>
    <div class="usecase-grid">
      {% for u in p.usecases %}
      <div class="usecase-card">
        <h3>{{ u.title }}</h3>
        <p>{{ u.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if p.videos %}
{% set vb = p.videos %}
{% include "_content/video-block.njk" %}
{% else %}
<section class="section">
  <div class="container">
    <div class="section-header">
      <div class="section-tagline">{{ t.labels.in_action }}</div>
      <h2>{{ t.labels.see_it_working }}</h2>
    </div>
    <div class="vid-embed-wrap">
      <div class="vid-placeholder">
        <span>{{ t.video.placeholder }}</span>
      </div>
    </div>
  </div>
</section>
{% endif %}

{# ROI calculator temporarily held — uncomment to restore: {% include "_content/roi-calculator.njk" %} #}

<section class="product-cta">
  <div class="container">
    <h2>{{ t.labels.product_cta_heading }}</h2>
    <p>{{ t.labels.product_cta_sub }}</p>
    <div class="product-cta-btns">
      {# Live Demo temporarily hidden — uncomment to restore: <a href="{{ ('/demo/' + productKey + '/') | localeUrl(lang) }}" class="btn btn-teal">{{ p.cta_demo }}</a> #}
      <a href="{{ '/how-to-buy/#dealer-form' | localeUrl(lang) }}" class="btn btn-teal">{{ p.cta_contact }}</a>
    </div>
  </div>
</section>

<script src="/assets/js/home.js"></script>
