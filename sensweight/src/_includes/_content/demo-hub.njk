{% set t = translations[lang] %}
{% set h = t.demo_hub %}
{# SensWEIGHT, SensSILO, SensBELT only — same three as the Solutions page. SensBELT is part of the
   SensWEIGHT platform and has no demo data of its own, so its card opens the SensWEIGHT demo. #}
{% set demoCards = [
  { key: "sensweight", icon: "SW", name: t.products.sensweight.name, desc: t.products.sensweight.desc, system: t.demos.sensweight.system, href: "/demo/sensweight/" },
  { key: "senssilo", icon: "SIL", name: t.products.senssilo.name, desc: t.products.senssilo.desc, system: t.demos.senssilo.system, href: "/demo/senssilo/" },
  { key: "sensbelt", icon: "BLT", name: "SensBELT", desc: "Continuous conveyor belt scale monitoring, part of the SensWEIGHT® platform.", system: "Runs on SensWEIGHT®", href: "/demo/sensweight/" }
] %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ h.tagline }}</div>
    <h1>{{ h.heading }}</h1>
    <p class="page-hero-sub">{{ h.sub }}</p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="solutions-grid">
      {% for c in demoCards %}
      <a class="sol-card" href="{{ c.href }}">
        <div class="sol-icon">{{ c.icon }}</div>
        <h3>{{ c.name }}</h3>
        <p>{{ c.desc }}</p>
        <div class="sol-footer">
          <span class="sol-product">{{ c.system }}</span>
          <span class="sol-link">{{ h.cta }} &rarr;</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
