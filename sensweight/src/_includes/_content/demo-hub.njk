{% set t = translations[lang] %}
{% set h = t.demo_hub %}
{% set icons = {sensweight: "SW", senssilo: "SIL", sensgeo: "GEO", sensatmo: "ATM", sensgreen: "GRN"} %}
{% set iconColors = {sensweight: "var(--blue)", senssilo: "var(--ok)", sensgeo: "var(--sky)", sensatmo: "var(--warn)", sensgreen: "var(--blue-dark)"} %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ h.tagline }}</div>
    <h1>{{ h.heading }}</h1>
    <p class="page-hero-sub">{{ h.sub }}</p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="solutions-grid">
      {% for key in ["sensweight", "senssilo", "sensgeo", "sensatmo", "sensgreen"] %}
      <a class="sol-card" href="/demo/{{ key }}/">
        <div class="sol-icon" style="background:{{ iconColors[key] }}">{{ icons[key] }}</div>
        <h3>{{ t.products[key].name }}</h3>
        <p>{{ t.products[key].desc }}</p>
        <div class="sol-footer">
          <span class="sol-product">{{ t.demos[key].system }}</span>
          <span class="sol-link">{{ h.cta }} &rarr;</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
