{% set t = translations[lang] %}
{% set s = t.solutions_index %}
{% set icons = {sensweight: "SW", senssilo: "SIL", sensgeo: "GEO", sensatmo: "ATM", sensgreen: "GRN"} %}
{% set iconColors = {sensweight: "var(--blue)", senssilo: "var(--ok)", sensgeo: "var(--sky)", sensatmo: "var(--warn)", sensgreen: "var(--blue-dark)"} %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ s.tagline }}</div>
    <h1>{{ s.heading }}</h1>
    <p class="page-hero-sub">{{ s.sub }}</p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="solutions-grid">
      {% for key in ["sensweight", "senssilo", "sensgeo", "sensatmo", "sensgreen"] %}
      {% set p = t.products[key] %}
      <a class="sol-card" href="/{{ key }}/">
        <div class="sol-icon" style="background:{{ iconColors[key] }}">{{ icons[key] }}</div>
        <h3>{{ p.name }}</h3>
        <p>{{ p.desc }}</p>
        <div class="sol-footer">
          <span class="sol-product">{{ p.badge }}</span>
          <span class="sol-link">Learn more →</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
