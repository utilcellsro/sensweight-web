{% set t = translations[lang] %}
{% set r = t.request_a_dealer %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ r.tagline }}</div>
    <h1>{{ r.heading }}</h1>
    <p class="page-hero-sub">{{ r.sub }}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <form class="contact-form" id="dealer-form">
      <div class="form-row">
        <div class="form-field">
          <label for="d-name">{{ r.label_name }}</label>
          <input type="text" id="d-name" name="name" required>
        </div>
        <div class="form-field">
          <label for="d-company">{{ r.label_company }}</label>
          <input type="text" id="d-company" name="company" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="d-email">{{ r.label_email }}</label>
          <input type="email" id="d-email" name="email" required>
        </div>
        <div class="form-field">
          <label for="d-phone">{{ r.label_phone }}</label>
          <input type="tel" id="d-phone" name="phone">
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="d-country">{{ r.label_country }}</label>
          <input type="text" id="d-country" name="country" required>
        </div>
        <div class="form-field">
          <label for="d-interest">{{ r.label_interest }}</label>
          <select id="d-interest" name="interest">
            <option value="">{{ r.option_default }}</option>
            <option value="SensWEIGHT">SensWEIGHT™</option>
            <option value="SensSILO">SensSILO™</option>
            <option value="SensGEO">SensGEO™</option>
            <option value="SensATMO">SensATMO™</option>
            <option value="SensGREEN">SensGREEN™</option>
            <option value="UCS X3">UCS X3</option>
          </select>
        </div>
      </div>
      <div class="form-field">
        <label for="d-message">{{ r.label_message }}</label>
        <textarea id="d-message" name="message" placeholder="{{ r.placeholder_message }}"></textarea>
      </div>
      <div>
        <button type="submit" class="btn btn-primary">{{ r.submit }} &rarr;</button>
      </div>
      <p class="form-note">{{ r.note }}</p>
    </form>
  </div>
</section>

<script src="/assets/js/dealer-form.js"></script>
