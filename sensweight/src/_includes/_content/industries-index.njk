{% set t = translations[lang] %}
{% set ind = t.industries %}
{% set industryKeys = ["quarries", "concrete", "silos", "recycling", "logistics", "beltscale", "geotechnical", "greenroofs"] %}
{% set indColors = {
  quarries: "var(--blue)", concrete: "var(--warn)", silos: "var(--ok)", recycling: "var(--sky)",
  logistics: "var(--blue-dark)", beltscale: "var(--blue)", geotechnical: "var(--sky)", greenroofs: "var(--blue-dark)"
} %}
{% set indIcons = {
  quarries: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 19h20"/><path d="M4 19 9 8l3 4.5L15 7l5 12"/></svg>',
  concrete: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h8l2 4v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V7z"/><path d="M6 9h12"/></svg>',
  silos: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8a3 1.4 0 0 1 6 0v10a3 1.4 0 0 1-6 0z"/><path d="M4 8a3 1.4 0 0 0 6 0"/><path d="M14 11a3 1.2 0 0 1 6 0v7a3 1.2 0 0 1-6 0z"/><path d="M14 11a3 1.2 0 0 0 6 0"/></svg>',
  recycling: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 8-8"/><path d="M9 2 12 4 9 7"/><path d="M20 12a8 8 0 0 1-8 8"/><path d="M15 22 12 20 15 17"/></svg>',
  logistics: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="9" width="11" height="8" rx="1"/><path d="M13 11h4l3 3v3h-7z"/><circle cx="6" cy="19" r="1.6"/><circle cx="17" cy="19" r="1.6"/></svg>',
  beltscale: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="7" width="6" height="5" rx="1"/><circle cx="6" cy="16" r="2.5"/><circle cx="18" cy="16" r="2.5"/><path d="M6 13.5h12M6 18.5h12"/></svg>',
  geotechnical: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><path d="M4 20 16 6"/><path d="M4 20a10 10 0 0 1 8-9.8" stroke-dasharray="2 2.5"/></svg>',
  greenroofs: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14h16l-2-6H6z"/><path d="M12 14v6"/><path d="M12 14c-2-2-2-5 0-7 2 2 2 5 0 7z"/></svg>'
} %}

<section class="page-hero">
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ ind.index_tagline }}</div>
    <h1>{{ ind.index_heading }}</h1>
    <p class="page-hero-sub">{{ ind.index_sub }}</p>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="solutions-grid">
      {% for key in industryKeys %}
      {% set item = ind.items[key] %}
      <a class="sol-card" href="/industries/{{ key }}/">
        <div class="sol-icon" style="background:{{ indColors[key] }}">{{ indIcons[key] | safe }}</div>
        <h3>{{ item.name }}</h3>
        <p>{{ item.tagline }}</p>
        <div class="sol-footer">
          <span class="sol-link">Learn more &rarr;</span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
