{% set t = translations[lang] %}
{% set ind = t.industries %}
{% set item = ind.items[industryKey] %}
{% set icons = {sensweight: "SW", senssilo: "SIL", sensgeo: "GEO", sensatmo: "ATM", sensgreen: "GRN"} %}
{% set iconColors = {sensweight: "var(--blue)", senssilo: "var(--ok)", sensgeo: "var(--sky)", sensatmo: "var(--warn)", sensgreen: "var(--blue-dark)"} %}

<section class="page-hero page-hero--photo">
  <div class="page-hero-bg" aria-hidden="true"><img src="/assets/images/industries/{{ industryKey }}.jpg" alt=""></div>
  <div class="container page-hero-content">
    <div class="hero-tagline">{{ item.kicker or item.tagline }}</div>
    <h1>{{ item.headline }}</h1>
    <p class="page-hero-sub">{{ item.sub }}</p>
    {% if item.badges %}
    <div class="page-hero-badges">
      {% for b in item.badges %}<span class="hero-badge">{{ b }}</span>{% endfor %}
    </div>
    {% endif %}
  </div>
</section>

{% if item.story %}
{% set s = item.story %}
{% include "_content/product-story.njk" %}
{% endif %}

<section class="section section-alt">
  <div class="container">
    <div class="section-header section-header--center">
      <div class="section-tagline">{{ ind.recommended_title }}</div>
      <h2>{{ item.name }}</h2>
    </div>
    <div class="solutions-grid">
      {% for key in item.solutions %}
      {% if key == "custom" %}
      {% set c = t.custom_solution %}
      <a class="sol-card" href="/how-to-buy/">
        <div class="sol-icon">+</div>
        <h3>{{ c.title }}</h3>
        <p>{{ c.desc_industry }}</p>
        <div class="sol-footer">
          <span class="sol-product">{{ c.badge }}</span>
          <span class="sol-link">{{ c.cta }} &rarr;</span>
        </div>
      </a>
      {% else %}
      {% set p = t.products[key] %}
      <a class="sol-card" href="/{{ key }}/">
        <div class="sol-icon" style="background:{{ iconColors[key] }}">{{ icons[key] }}</div>
        <h3>{{ p.name }}</h3>
        <p>{{ p.desc }}</p>
        <div class="sol-footer">
          <span class="sol-product">{{ p.badge }}</span>
          <span class="sol-link">Learn more &rarr;</span>
        </div>
      </a>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="product-cta">
  <div class="container">
    {% if item.story and item.story.pilot %}
    {% set pl = item.story.pilot %}
    <div class="section-tagline">Next step</div>
    <h2>{{ pl.heading }}</h2>
    <p>{{ pl.body }}</p>
    <div class="steps-grid pilot-points">
      {% for pt in pl.points %}
      <div class="step-card">
        <h3>{{ pt.title }}</h3>
        <p>{{ pt.body }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="product-cta-btns">
      <a href="/how-to-buy/#dealer-form" class="btn btn-teal">Start a pilot</a>
      <a href="/products/" class="btn btn-ghost">{{ ind.cta_products }}</a>
    </div>
    {% else %}
    <h2>Ready to talk about {{ item.name }}?</h2>
    <p>Get a tailored quote, or see the recommended hardware for this application.</p>
    <div class="product-cta-btns">
      <a href="/how-to-buy/" class="btn btn-teal">{{ ind.cta_buy }}</a>
      <a href="/products/" class="btn btn-ghost">{{ ind.cta_products }}</a>
    </div>
    {% endif %}
  </div>
</section>
