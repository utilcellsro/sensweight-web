{# Shared by the homepage and /industries/ — photo tiles, same pattern as the Solutions tiles.
   Photos in /assets/images/industries/: silos, logistics, beltscale, geotechnical are the toned photos from
   unifiedcloudsensors.com; quarries, concrete, recycling, greenroofs are Unsplash-licensed stand-ins toned to match. #}
{% set ind = t.industries %}
<div class="industry-tiles">
  {% for key in ["quarries", "concrete", "silos", "recycling", "logistics", "beltscale", "geotechnical", "greenroofs"] %}
  {% set item = ind.items[key] %}
  <a class="industry-tile" href="/industries/{{ key }}/">
    <div class="industry-tile-bg"><img src="/assets/images/industries/{{ key }}.jpg" alt="" loading="lazy"></div>
    <div class="industry-tile-scrim"></div>
    <span class="industry-tile-num">{{ "0" + loop.index if loop.index < 10 else loop.index }}</span>
    <div class="industry-tile-label">
      <span class="industry-tile-name">{{ item.name }}</span>
      <p class="industry-tile-tagline">{{ item.tagline }}</p>
      <span class="industry-tile-route">
        {%- for s in item.solutions -%}
        {{ t.custom_solution.title if s == "custom" else t.products[s].name }}{{ " · " if not loop.last }}
        {%- endfor %} &rarr;
      </span>
    </div>
  </a>
  {% endfor %}
</div>
