{# Shared by the homepage and /solutions/ — the same 3 tiles as unifiedcloudsensors.com (SensWEIGHT Bridge / SensSILO / SensBELT) #}
<div class="solution-tiles">
  <a href="{{ '/sensweight/' | localeUrl(lang) }}" class="solution-tile">
    <div class="solution-tile-bg"><img src="/assets/images/sensweight.jpg" alt="" loading="lazy"></div>
    <div class="solution-tile-scrim"></div>
    <div class="solution-tile-label">
      <span class="solution-tile-kicker">{{ t.labels.tile_flagship }}</span>
      <span class="solution-tile-name">SensWEIGHT® Bridge</span>
      <p>{{ t.products.sensweight.desc }}</p>
    </div>
  </a>
  <a href="{{ '/senssilo/' | localeUrl(lang) }}" class="solution-tile">
    <div class="solution-tile-bg"><img src="/assets/images/senssilo.jpg" alt="" loading="lazy"></div>
    <div class="solution-tile-scrim"></div>
    <div class="solution-tile-label">
      <span class="solution-tile-kicker solution-tile-kicker--sky">{{ t.labels.tile_level }}</span>
      <span class="solution-tile-name">SensSILO</span>
      <p>{{ t.products.senssilo.desc }}</p>
    </div>
  </a>
  <a href="{{ '/industries/beltscale/' | localeUrl(lang) }}" class="solution-tile">
    <div class="solution-tile-bg"><img src="/assets/images/sensbelt.jpg" alt="" loading="lazy"></div>
    <div class="solution-tile-scrim"></div>
    <div class="solution-tile-label">
      <span class="solution-tile-kicker">{{ t.labels.tile_beltscale }}</span>
      <span class="solution-tile-name">SensBELT</span>
      <p>{{ t.labels.sensbelt_desc }}</p>
    </div>
  </a>
