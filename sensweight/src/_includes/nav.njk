{% set t = translations[lang] %}
<nav class="nav">
  <div class="container nav-inner">
    <a class="nav-logo" href="{{ '/' | localeUrl(lang) }}">
      <img class="nav-logo-img" src="/assets/images/ucs-mark-white.png" alt="UCS">
      <span class="nav-logo-text">Unified Cloud Sensors</span>
    </a>
    <div class="nav-links">
      <a href="{{ '/about/' | localeUrl(lang) }}">{{ t.nav.about }}</a>
      <a href="{{ '/events/' | localeUrl(lang) }}">{{ t.nav.news }}</a>
      <a href="{{ '/contact/' | localeUrl(lang) }}" class="nav-cta">{{ t.nav.contact }}</a>
      {# Language switcher — the same page in each language, built from this
         page's own `route` so it can never link to a URL the build doesn't
         produce. A singleLanguage page (the privacy policy, English only) has
         no counterpart to offer, so it falls back to that language's home page
         and drops the hreflang hint, which would otherwise claim the home page
         is this page's translation. #}
      {%- set switchRoute = '/' if singleLanguage else route %}
      <span class="lang-switch" role="group" aria-label="{{ t.ui.language }}">
        {%- for l in langs %}
        {%- if l == lang %}
        <span class="lang-switch-item is-active" aria-current="true">{{ l | upper }}</span>
        {%- else %}
        <a class="lang-switch-item" href="{{ switchRoute | localeUrl(l) }}" lang="{{ l }}"{% if not singleLanguage %} hreflang="{{ l }}"{% endif %}>{{ l | upper }}</a>
        {%- endif %}
        {%- endfor %}
      </span>
    </div>
  </div>
</nav>
