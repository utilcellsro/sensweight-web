<!DOCTYPE html>
{% set t = translations[lang] %}
{#- Per-page title/description. English lives in each page's front matter;
    CS/PL override it via translations[lang].meta[route]. A language that has
    not translated a given page keeps the English title rather than shipping
    an empty one. -#}
{% set m = t.meta[route] if t.meta and route else none %}
{% set pageTitle = m.title if m and m.title else title %}
{% set pageDesc = (m.description if m and m.description else description) | default(site.description) %}
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1D2C49">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if noindexed %}<meta name="robots" content="noindex, follow">{% endif %}
  {%- if not noindexed and route and not singleLanguage %}
  {#- Every language's version of this same page, built from `route` so an
      alternate can never point at a URL the build doesn't produce. x-default
      is the English one, which is served unprefixed at the root. -#}
  {%- for l in langs %}
  <link rel="alternate" hreflang="{{ l }}" href="{{ site.url }}{{ route | localeUrl(l) }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ route }}">
  {%- endif %}

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/images/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="{{ t.ui.og_locale }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage | default(site.ogImage) }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage | default(site.ogImage) }}">
  {# Fonts are served from this origin, not fonts.googleapis.com, so rendering a
     page sends nothing to Google. See scripts/vendor-fonts.js for how the files
     and fonts.css are produced. The two preloads are the faces every page uses
     immediately (body text and headings); `crossorigin` is required even
     same-origin or the browser fetches the file twice. #}
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-var-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/chakra-petch-700-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  {% if pageKey == 'demo' %}
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  {% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.url }}/#organization",
        "name": {{ site.name | jsonstr | safe }},
        "legalName": {{ site.legalName | jsonstr | safe }},
        "url": "{{ site.url }}/",
        "logo": "{{ site.url }}/assets/images/ucs-logo.png",
        "description": {{ site.description | jsonstr | safe }},
        "vatID": "{{ site.vatId }}",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": {{ site.street | jsonstr | safe }},
          "addressCountry": "{{ site.country }}"
        },
        "sameAs": ["{{ site.linkedin }}"]
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": {{ site.name | jsonstr | safe }},
        "publisher": { "@id": "{{ site.url }}/#organization" }
      },
      {%- set crumbParents = {
          "industry":   [t.nav.industries, "/industries/"],
          "sensweight": [t.nav.solutions, "/solutions/"],
          "senssilo":   [t.nav.solutions, "/solutions/"],
          "ucsx3":      [t.nav.products, "/products/"],
          "demo":       [t.nav.demo, "/demo/"]
        } %}
      {%- set parent = crumbParents[pageKey] %}
      {%- set pageName = productName | default((pageTitle | split(" | "))[0]) %}
      {
        "@type": "BreadcrumbList",
        "@id": "{{ site.url }}{{ page.url }}#breadcrumb",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {{ t.ui.home | jsonstr | safe }}, "item": "{{ site.url }}{{ '/' | localeUrl(lang) }}" }{% if parent %},
          { "@type": "ListItem", "position": 2, "name": {{ parent[0] | jsonstr | safe }}, "item": "{{ site.url }}{{ parent[1] | localeUrl(lang) }}" },
          { "@type": "ListItem", "position": 3, "name": {{ pageName | jsonstr | safe }}, "item": "{{ site.url }}{{ page.url }}" }{% elif page.url != ('/' | localeUrl(lang)) %},
          { "@type": "ListItem", "position": 2, "name": {{ pageName | jsonstr | safe }}, "item": "{{ site.url }}{{ page.url }}" }{% endif %}
        ]
      },
      {% if productName %}
      {
        "@type": "Product",
        "@id": "{{ site.url }}{{ page.url }}#product",
        "name": {{ productName | jsonstr | safe }},
        "description": {{ pageDesc | jsonstr | safe }},
        "url": "{{ site.url }}{{ page.url }}",
        {% if productImage %}"image": "{{ site.url }}{{ productImage }}",{% endif %}
        "category": {{ productCategory | jsonstr | safe }},
        "brand": { "@type": "Brand", "name": {{ site.name | jsonstr | safe }} },
        "manufacturer": { "@id": "{{ site.url }}/#organization" }
      },
      {% endif %}
      {
        "@type": "WebPage",
        "@id": "{{ site.url }}{{ page.url }}#webpage",
        "url": "{{ site.url }}{{ page.url }}",
        "name": {{ pageTitle | jsonstr | safe }},
        "description": {{ pageDesc | jsonstr | safe }},
        "inLanguage": "{{ lang }}",
        "isPartOf": { "@id": "{{ site.url }}/#website" }
      }
    ]
  }
  </script>
</head>
<body{% if demoKey %} data-demo-key="{{ demoKey }}"{% endif %}>
{% include "nav.njk" %}
{% include "breadcrumb.njk" %}
{{ content | safe }}
{% include "footer.njk" %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.nav-links a').forEach(function(a) {
      if (a.href === window.location.href) a.classList.add('active');
    });
  });
</script>
{% if pageKey == 'demo' %}
<script src="/assets/js/demo-configs.js"></script>
<script src="/assets/js/demo.js"></script>
{% endif %}
</body>
</html>
