{% set t = translations[lang] %}
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="footer-logo">
          <img class="footer-logo-img" src="/assets/images/ucs-mark.png" alt="UCS">
          <span class="footer-company">{{ t.footer.company }}</span>
        </div>
        <p>{{ t.footer.address }}</p>
        {% for d in t.contact_page.details %}{% if d.key == "phone" %}
        <a href="tel:{{ d.value | replace(' ', '') }}">{{ d.value }}</a>
        {% elif d.key == "email" %}
        <a href="mailto:{{ d.value }}">{{ d.value }}</a>
        {% endif %}{% endfor %}
      </div>
      <nav class="footer-col">
        <span class="footer-col-title">{{ t.ui.explore }}</span>
        <a href="{{ '/industries/' | localeUrl(lang) }}">{{ t.nav.industries }}</a>
        <a href="{{ '/solutions/' | localeUrl(lang) }}">{{ t.nav.solutions }}</a>
        <a href="{{ '/products/' | localeUrl(lang) }}">{{ t.nav.products }}</a>
        {# Live Demo temporarily hidden — uncomment to restore: <a href="{{ '/demo/' | localeUrl(lang) }}">{{ t.nav.demo }}</a> #}
      </nav>
      <nav class="footer-col">
        <span class="footer-col-title">{{ t.ui.company }}</span>
        <a href="{{ '/about/' | localeUrl(lang) }}">{{ t.nav.about }}</a>
        <a href="{{ '/events/' | localeUrl(lang) }}">{{ t.nav.news }}</a>
        <a href="{{ '/how-to-buy/' | localeUrl(lang) }}">{{ t.ui.how_to_buy }}</a>
        <a href="{{ '/contact/' | localeUrl(lang) }}">{{ t.nav.contact }}</a>
        <a href="https://www.unifiedcloudsensors.com/" target="_blank" rel="noopener">unifiedcloudsensors.com</a>
        {# Both legal pages are English-only, so these hrefs are deliberately not localised. #}
        <a href="/privacy/">{{ t.ui.privacy }}</a>
        <a href="/terms/">{{ t.ui.terms }}</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <span>© 2026 {{ t.footer.company }} — {{ t.footer.rights }}</span>
    </div>
  </div>
</footer>
